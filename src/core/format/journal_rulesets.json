          "footnote_sequence": ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"]
        }
      },
      {
        "journal_id": "GENERIC",
        "display_name": "Standard/Generic Format",
        "provenance": { "source_title": "EasyTableOne generic style (no journal source)", "source_url": null, "retrieved_on": null, "last_reviewed_on": "2026-10-09", "notes": "Not derived from a journal's instructions." },
        "table_title_template": "Table 1: Baseline Characteristics, by {grouping_label}",
        "variable_coding_section_title": "Variable coding notes",

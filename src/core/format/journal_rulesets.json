          "percentage_decimals": 0
        },
        "table_styling": {
          "bold_headers": true,
          "indent_subgroups": true,
          "row_spacing": "standard",
          "footnote_sequence": ["*", "†", "‡", "§", "||", "¶", "#", "**", "††", "‡‡", "§§", "||||"]
        }
      },
      {
        "journal_id": "NATURE_MED",
        "display_name": "Nature Medicine",
        "provenance": { "source_title": "Nature Portfolio Reporting Summary (statistics section); Nature Medicine formatting guide", "source_url": "https://www.nature.com/documents/nr-reporting-summary-flat.pdf", "retrieved_on": "2026-09-29", "last_reviewed_on": "2026-10-09", "notes": "Stated: give P values as exact values whenever suitable. The formatting guide (https://www.nature.com/nm/submission-guidelines/aip-and-formatting) does not prescribe table number formats. House convention (not stated): Mean ± SD, Median (IQR) with comma delimiter, italic P, leading zero, P<0.001 threshold, one-decimal percentages, letter footnotes." },
        "table_title_template": "Table 1: Baseline Characteristics, by {grouping_label}",
        "variable_coding_section_title": "Variable coding notes",
        "data_quality_section_title": "Data quality notes",
        "number_format": {
          "thousand_separator": true,
          "suppress_trailing_zero": true,
          "decimal_precision": 1
        },
        "plot_theme": {
          "seaborn_style": "white",
          "color_palette": ["#E64B35", "#4DBBD5", "#00A087", "#3C5488", "#F39B7F", "#8491B4", "#91D1C2"],
          "font_family": "DejaVu Sans",
          "font_size_base": 8,
          "despine": true,
          "bar_edge_color": "none",
          "bar_edge_linewidth": 0.0,

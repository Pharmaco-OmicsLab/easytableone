{
  "EasyTableOne_Ruleset": {
    "version": "1.7",
    "changelog": "v1.7 (Session 125): added per-journal provenance and review_policy (D106). No formatting value changed. v1.6 (Session 124): JAMA categorical label 'No. (%)' and whole-number percentages when the column N < 100, per JAMA Network Instructions for Authors (https://jamanetwork.com/journals/jamanetworkopen/pages/instructions-for-authors, retrieved 2026-09-29) (D108). Lancet p values to two significant figures unless p<0·0001, threshold parsing fixed for the midline decimal point, and bold table headings, per The Lancet Information for Authors, August 2026 (D109). No other journal changed. v1.5: Added summary_statistics.continuous_label_template per D104(c). v1.4 (Session 104): suppress_trailing_zero is now a row-level rule (D86) - a variable renders without decimals only when every summary value for that variable is integer-valued. Ruleset values are unchanged. v1.3 (Session 14): Added data_quality_section_title per D42. v1.2 (Session 12): Added table_title_template, variable_coding_section_title, number_format fields per D35-D40. v1.1: Replaced normality_threshold with normality_logic block. NOTE: `conditional_decimals` rules MUST be ordered most-specific-first. Patch: NEJM iqr_delimiter is ' to ' (with spaces) for readable output.",
    "review_policy": { "cadence_months": 6, "also_before": "each minor release", "report_discrepancy": "GitHub issue template 'Ruleset discrepancy'" },
    "global_defaults": {
      "missing_data_label": "Missing",
      "normality_logic": {
        "small_n_test": "shapiro",
        "small_n_threshold_p": 0.05,
        "large_n_threshold_n": 2000,
        "large_n_skew_max": 1.0,
        "large_n_kurt_max": 1.0
      },
      "test_selection_logic": {
        "continuous_normal": "Student's t-test (2 groups) or ANOVA (>2 groups)",
        "continuous_non_normal": "Mann-Whitney U (2 groups) or Kruskal-Wallis (>2 groups)",
        "categorical_large_sample": "Chi-square test",
        "categorical_small_sample": "Fisher's exact test (if any cell < 5)"
      }
    },
    "journals": [
      {
        "journal_id": "NEJM",
        "display_name": "New England Journal of Medicine",
        "provenance": { "source_title": "NEJM Author Center — New Manuscripts: Statistical Reporting Guidelines (A.1.g)", "source_url": "https://www.nejm.org/author-center/new-manuscripts", "retrieved_on": "2026-10-09", "last_reviewed_on": "2026-10-09", "notes": "Stated: P values larger than 0.01 to two decimal places, between 0.01 and 0.001 to three, smaller than 0.001 as P<0.001 (also Harrington et al., N Engl J Med 2019;381:285-6, doi:10.1056/NEJMe1906559). House convention (not stated): leading zero, Mean (SD) and Median (IQR) labels, 'to' as IQR delimiter, whole-number percentages, thousands separator, footnote symbol sequence." },
        "table_title_template": "Table 1: Baseline Characteristics, by {grouping_label}",
        "variable_coding_section_title": "Variable coding notes",
        "data_quality_section_title": "Data quality notes",
        "number_format": {
          "thousand_separator": true,
          "suppress_trailing_zero": true,
          "decimal_precision": 1
        },
        "plot_theme": {
          "seaborn_style": "ticks",
          "color_palette": ["#BC3C29", "#0072B5", "#E18727", "#20854E", "#7876B1", "#6F99AD", "#FFDC91", "#EE4C97"],
          "font_family": "DejaVu Sans",
          "font_size_base": 8,
          "despine": true,
          "bar_edge_color": "black",
          "bar_edge_linewidth": 0.5,
          "line_width": 1.0,
          "figure_dpi_screen": 150,
          "figure_dpi_export": 300
        },
        "p_value_formatting": {
          "leading_zero": true,
          "max_decimal_places": 3,
          "conditional_decimals": [
            { "range": ">= 0.01", "decimals": 2 },
            { "range": "0.001 to 0.01", "decimals": 3 }
          ],
          "threshold_low": "<0.001",
          "italicize_p": false
        },
        "summary_statistics": {
          "continuous_normal": "Mean (SD)",
          "continuous_non_normal": "Median (IQR)",
          "continuous_label_template": "{label} ({unit}), {summary}",
          "iqr_delimiter": " to ",
          "categorical": "n (%)",
          "percentage_decimals": 0
        },
        "table_styling": {
          "bold_headers": true,
          "indent_subgroups": true,
          "row_spacing": "compact",
          "footnote_sequence": ["*", "†", "‡", "§", "¶", "||", "**", "††", "‡‡", "§§", "¶¶", "||||"]
        }
      },
      {
        "journal_id": "JAMA",
        "display_name": "Journal of the American Medical Association",
        "provenance": { "source_title": "JAMA Instructions for Authors: Statistical Methods and Data Presentation; Tables; Table Footnotes", "source_url": "https://jamanetwork.com/journals/jama/pages/instructions-for-authors", "retrieved_on": "2026-10-09", "last_reviewed_on": "2026-10-09", "notes": "Stated: P<.001; .001 to .01 to the nearest thousandth; >=.01 to the nearest hundredth; P>.99; no leading zero (example 'P = .13'); italic P; mean (SD) and median (IQR); frequencies as 'No. (%)'; no decimal places in percentages when the sample size is less than 100 (D108); superscript letters for table footnotes. House convention (not stated): hyphen IQR delimiter, thousands separator, one decimal place for percentages when N >= 100. The guidance also states that randomized-trial baseline tables should not include P values (see the RCT advisory, D101)." },
        "table_title_template": "Table 1: Baseline Characteristics, by {grouping_label}",
        "variable_coding_section_title": "Variable coding notes",
        "data_quality_section_title": "Data quality notes",
        "number_format": {
          "thousand_separator": true,
          "suppress_trailing_zero": true,
          "decimal_precision": 1
        },
        "plot_theme": {
          "seaborn_style": "ticks",
          "color_palette": ["#374E55", "#DF8F44", "#00A1D5", "#B24745", "#79AF97", "#6A6599", "#80796B"],
          "font_family": "DejaVu Sans",
          "font_size_base": 8,
          "despine": true,
          "bar_edge_color": "black",
          "bar_edge_linewidth": 0.5,
          "line_width": 1.0,
          "figure_dpi_screen": 150,
          "figure_dpi_export": 300
        },
        "p_value_formatting": {
          "leading_zero": false,
          "max_decimal_places": 3,
          "conditional_decimals": [
            { "range": "> 0.99", "display": "> .99" },
            { "range": ">= 0.01", "decimals": 2 },
            { "range": "0.001 to 0.01", "decimals": 3 }
          ],
          "threshold_low": "<.001",
          "italicize_p": true
        },
        "summary_statistics": {
          "continuous_normal": "Mean (SD)",
          "continuous_non_normal": "Median (IQR)",
          "continuous_label_template": "{label}, {summary}, {unit}",
          "iqr_delimiter": "-",
          "categorical": "No. (%)",
          "percentage_decimals": 1,
          "percentage_decimals_rule": { "below_n": 100, "decimals": 0 }
        },
        "table_styling": {
          "bold_headers": true,
          "indent_subgroups": true,
          "row_spacing": "standard",
          "footnote_sequence": ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"]
        }
      },
      {
        "journal_id": "LANCET",
        "display_name": "The Lancet",
        "provenance": { "source_title": "The Lancet — Information for Authors (August 2026)", "source_url": "https://www.thelancet.com/pb-assets/Lancet/authors/tl-info-for-authors-1690986041530.pdf", "retrieved_on": "2026-10-09", "last_reviewed_on": "2026-10-09", "notes": "Stated: midline decimal point (23·4); means accompanied by SDs and medians by IQR; p values to two significant figures unless p<0·0001 (D109); headings within tables in bold (D109). House convention (not stated): leading zero, en dash IQR delimiter, whole-number percentages, footnote symbol sequence. Not implemented: lowercase 'p' column label and 8-point Times New Roman table font (PLAN §17)." },
        "table_title_template": "Table 1: Baseline Characteristics, by {grouping_label}",
        "variable_coding_section_title": "Variable coding notes",
        "data_quality_section_title": "Data quality notes",
        "number_format": {
          "thousand_separator": true,

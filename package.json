{
  "name": "easytableone",
  "private": true,
  "version": "3.19.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist-offline.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:pyodide": "vitest run --project pyodide",
    "test:projects": "node scripts/check-vitest-projects.mjs",
    "verify": "pnpm test:projects && pnpm typecheck && pnpm test && pnpm build",
    "test:golden": "vitest run tests/golden/",
    "validation:r": "node scripts/crossval/run-r.mjs",
    "validation:report": "cross-env ETO_WRITE_VALIDATION_REPORT=1 vitest run --project pyodide tests/golden/",
    "test:fixtures": "vitest run tests/fixtures.test.ts",
    "test:roundtrip": "vitest run tests/outlier_roundtrip.test.ts",
    "test:perf": "cross-env PERF_TEST=1 vitest run tests/perf.test.ts",
    "test:e2e": "playwright test --project=smoke-dev",
    "test:e2e:locality": "playwright test --project=prod-chromium",
    "test:e2e:all": "playwright test --project=smoke-dev --project=prod-chromium --project=prod-firefox --project=prod-webkit",
    "mirror:check": "node scripts/mirror-check.mjs",
    "test:inventory": "node scripts/test-inventory.mjs",
    "docs:api": "typedoc",
    "bench": "node scripts/bench/make-bench-data.mjs && playwright test -c playwright.bench.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "markdown-it": "^14.2.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vega": "6.2.0",
    "vega-embed": "7.1.0",
    "vega-interpreter": "^2.2.1",
    "vega-lite": "6.4.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.7.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "postcss": "^8.5.12",
    "pyodide": "314.0.0-alpha.1",
    "tailwindcss": "^3.4.19",
    "typedoc": "0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "yaml": "2.9.1"
  }
}
